# ─────────────────────────────────────────────────────────────
# Knowhere Tech - Firebase Client Environment Variables
# Copy these values from Firebase Console > Project Settings > General > Your Apps (Web)
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSyYourActualApiKeyFromFirebaseConsole
VITE_FIREBASE_AUTH_DOMAIN=knowheretech.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=knowheretech
VITE_FIREBASE_STORAGE_BUCKET=knowheretech.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
